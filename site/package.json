{
  "name": "cartridge-browser",
  "private": true,
  "license": "MIT",
  "version": "0.1.0",
  "type": "module",
  "description": "A browser for the C.I.P. Tables of Dimensions of Cartridges and Chambers",
  "scripts": {
    "sample-bullets": "vite-node scripts/sample-bullets.ts",
    "index": "vite-node scripts/build-index.mjs",
    "fieldsets": "node scripts/build-fieldsets.mjs",
    "prepare-data": "npm run index && npm run fieldsets",
    "dev": "npm run prepare-data && vite",
    "pretest": "npm run prepare-data",
    "test": "vitest run",
    "build": "npm run prepare-data && svelte-check --tsconfig ./tsconfig.json && vite build",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@internationalized/date": "^3.12.4",
    "@lucide/svelte": "^1.43.0",
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tsconfig/svelte": "^5.0.4",
    "@types/node": "^26.4.1",
    "bits-ui": "^2.19.0",
    "clsx": "^2.1.1",
    "flag-icons": "^7.5.0",
    "shadcn-svelte": "^1.6.1",
    "svelte": "^5.2.0",
    "svelte-check": "^4.0.0",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vite-node": "^2.1.9",
    "vitest": "^2.1.9"
  }
}
